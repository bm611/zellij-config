tab_template name="ui" {
   children
   pane size=1 borderless=true {
       plugin location="file:/Users/broxdeez/.config/zellij/plugins/zjstatus.wasm" {
           format_left "#[fg=#6272a4,bg=default] {session}  {tabs}"
           format_center "{mode}"
           format_right "{notifications}{swap_layout}{command_git_branch}{command_cwd}{datetime}"
           format_space "#[bg=default]"
           format_hide_on_overlength "true"
           format_precedence "lrc"
           border_enabled "false"
           hide_frame_for_single_pane "false"
           tab_normal "#[fg=#44475a,bg=default]#[fg=#f8f8f2,bg=#44475a] {index} {name}{fullscreen_indicator}{sync_indicator}{floating_indicator} #[fg=#44475a,bg=default]"
           tab_active "#[fg=#bd93f9,bg=default]#[fg=#282a36,bg=#bd93f9,bold] {index} {name}{fullscreen_indicator}{sync_indicator}{floating_indicator} #[fg=#bd93f9,bg=default]"
           tab_separator "#[bg=default] "
           tab_fullscreen_indicator " 󰊓"
           tab_sync_indicator " ↔"
           tab_floating_indicator " 󰉈"
           command_cwd_command "/bin/sh /Users/broxdeez/.config/zellij/scripts/status-cwd.sh"
           command_cwd_format "#[fg=#8be9fd,bg=default] {stdout}"
           command_cwd_interval "1"
           command_cwd_rendermode "static"
           command_cwd_cwd "{focused_pane_cwd}"
           command_git_branch_command "/bin/sh /Users/broxdeez/.config/zellij/scripts/status-git.sh"
           command_git_branch_format "#[fg=#bd93f9,bg=default] {stdout}"
           command_git_branch_interval "2"
           command_git_branch_rendermode "static"
           command_git_branch_cwd "{focused_pane_cwd}"
           swap_layout_format "#[fg=#6272a4,bg=default] 󰕰 {name}"
           swap_layout_hide_if_empty "true"
           datetime "#[fg=#6272a4,bg=default] {format} "
           datetime_format "%H:%M"
           datetime_timezone "Europe/Amsterdam"
           notification_format_unread "#[fg=#282a36,bg=#f1fa8c,bold] 󰂞 {message} #[bg=default] "
           notification_format_no_notifications ""
           notification_show_interval "10"
           mode_normal ""
           mode_locked "#[bg=#ff5555,fg=#282a36,bold] LOCKED #[bg=default] #[bg=default,fg=#f8f8f2,bold]ctrl g#[fg=#6272a4,nobold] unlock"
           mode_pane "#[bg=#8be9fd,fg=#282a36,bold] PANE #[bg=default] #[bg=default,fg=#f8f8f2,bold]hjkl#[fg=#6272a4,nobold] focus#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]n#[fg=#6272a4,nobold] new#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]d/r#[fg=#6272a4,nobold] split ↓/→#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]s#[fg=#6272a4,nobold] stack#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]x#[fg=#6272a4,nobold] close#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]f#[fg=#6272a4,nobold] full#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]e#[fg=#6272a4,nobold] float#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]w#[fg=#6272a4,nobold] floats#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]c#[fg=#6272a4,nobold] rename"
           mode_tab "#[bg=#8be9fd,fg=#282a36,bold] TAB #[bg=default] #[bg=default,fg=#f8f8f2,bold]hjkl/1-9#[fg=#6272a4,nobold] go#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]n#[fg=#6272a4,nobold] new#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]x#[fg=#6272a4,nobold] close#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]r#[fg=#6272a4,nobold] rename#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]b/[/]#[fg=#6272a4,nobold] break pane#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]s#[fg=#6272a4,nobold] sync#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]tab#[fg=#6272a4,nobold] last"
           mode_resize "#[bg=#ffb86c,fg=#282a36,bold] RESIZE #[bg=default] #[bg=default,fg=#f8f8f2,bold]hjkl#[fg=#6272a4,nobold] grow#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]HJKL#[fg=#6272a4,nobold] shrink#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]+/-#[fg=#6272a4,nobold] size"
           mode_move "#[bg=#ffb86c,fg=#282a36,bold] MOVE #[bg=default] #[bg=default,fg=#f8f8f2,bold]hjkl#[fg=#6272a4,nobold] move#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]n/p#[fg=#6272a4,nobold] cycle"
           mode_scroll "#[bg=#f1fa8c,fg=#282a36,bold] SCROLL #[bg=default] #[bg=default,fg=#f8f8f2,bold]j/k#[fg=#6272a4,nobold] line#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]d/u#[fg=#6272a4,nobold] half page#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold][/]#[fg=#6272a4,nobold] prompt#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]s#[fg=#6272a4,nobold] search#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]e#[fg=#6272a4,nobold] edit#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]c#[fg=#6272a4,nobold] copy output"
           mode_search "#[bg=#f1fa8c,fg=#282a36,bold] SEARCH #[bg=default] #[bg=default,fg=#f8f8f2,bold]n/p#[fg=#6272a4,nobold] next/prev#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]c#[fg=#6272a4,nobold] case#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]w#[fg=#6272a4,nobold] wrap#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]o#[fg=#6272a4,nobold] whole word"
           mode_enter_search "#[bg=#f1fa8c,fg=#282a36,bold] SEARCH #[bg=default] #[bg=default,fg=#f8f8f2,bold]enter#[fg=#6272a4,nobold] search#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]esc#[fg=#6272a4,nobold] cancel"
           mode_session "#[bg=#8be9fd,fg=#282a36,bold] SESSION #[bg=default] #[bg=default,fg=#f8f8f2,bold]w#[fg=#6272a4,nobold] sessions#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]l#[fg=#6272a4,nobold] layouts#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]c#[fg=#6272a4,nobold] config#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]p#[fg=#6272a4,nobold] plugins#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]s#[fg=#6272a4,nobold] share#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]d#[fg=#6272a4,nobold] detach"
           mode_rename_tab "#[bg=#ff79c6,fg=#282a36,bold] RENAME #[bg=default] #[bg=default,fg=#f8f8f2,bold]enter#[fg=#6272a4,nobold] save#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]esc#[fg=#6272a4,nobold] cancel"
           mode_rename_pane "#[bg=#ff79c6,fg=#282a36,bold] RENAME #[bg=default] #[bg=default,fg=#f8f8f2,bold]enter#[fg=#6272a4,nobold] save#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]esc#[fg=#6272a4,nobold] cancel"
           mode_tmux "#[bg=#8be9fd,fg=#282a36,bold] TMUX #[bg=default] #[bg=default,fg=#f8f8f2,bold]\"/%#[fg=#6272a4,nobold] split#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]c#[fg=#6272a4,nobold] tab#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]n/p#[fg=#6272a4,nobold] tab#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]z#[fg=#6272a4,nobold] full#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]space#[fg=#6272a4,nobold] swap layout#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold][#[fg=#6272a4,nobold] scroll#[fg=#44475a] · #[bg=default,fg=#f8f8f2,bold]d#[fg=#6272a4,nobold] detach"
       }
   }
}

swap_tiled_layout name="vertical" {
    ui max_panes=4 {
        pane split_direction="vertical" {
            pane
            pane { children; }
        }
    }
    ui max_panes=7 {
        pane split_direction="vertical" {
            pane { children; }
            pane { pane; pane; pane; pane; }
        }
    }
    ui max_panes=11 {
        pane split_direction="vertical" {
            pane { children; }
            pane { pane; pane; pane; pane; }
            pane { pane; pane; pane; pane; }
        }
    }
}

swap_tiled_layout name="horizontal" {
    ui max_panes=3 {
        pane
        pane
    }
    ui max_panes=7 {
        pane {
            pane split_direction="vertical" { children; }
            pane split_direction="vertical" { pane; pane; pane; pane; }
        }
    }
    ui max_panes=11 {
        pane {
            pane split_direction="vertical" { children; }
            pane split_direction="vertical" { pane; pane; pane; pane; }
            pane split_direction="vertical" { pane; pane; pane; pane; }
        }
    }
}

swap_tiled_layout name="stacked" {
    ui min_panes=3 {
        pane stacked=true { children; }
    }
}

swap_tiled_layout name="half-stacked" {
    ui min_panes=4 {
        pane split_direction="vertical" {
            pane
            pane stacked=true { children; }
        }
    }
}

swap_floating_layout name="staggered" {
    floating_panes
}

swap_floating_layout name="enlarged" {
    floating_panes max_panes=10 {
        pane { x "5%"; y 1; width "90%"; height "90%"; }
        pane { x "5%"; y 2; width "90%"; height "90%"; }
        pane { x "5%"; y 3; width "90%"; height "90%"; }
        pane { x "5%"; y 4; width "90%"; height "90%"; }
        pane { x "5%"; y 5; width "90%"; height "90%"; }
        pane { x "5%"; y 6; width "90%"; height "90%"; }
        pane { x "5%"; y 7; width "90%"; height "90%"; }
        pane { x "5%"; y 8; width "90%"; height "90%"; }
        pane { x "5%"; y 9; width "90%"; height "90%"; }
        pane { x 10; y 10; width "90%"; height "90%"; }
    }
}

swap_floating_layout name="spread" {
    floating_panes max_panes=1 {
        pane {y "50%"; x "50%"; }
    }
    floating_panes max_panes=2 {
        pane { x "1%"; y "25%"; width "45%"; }
        pane { x "50%"; y "25%"; width "45%"; }
    }
    floating_panes max_panes=3 {
        pane { y "55%"; width "45%"; height "45%"; }
        pane { x "1%"; y "1%"; width "45%"; }
        pane { x "50%"; y "1%"; width "45%"; }
    }
    floating_panes max_panes=4 {
       pane { x "1%"; y "55%"; width "45%"; height "45%"; }
       pane { x "50%"; y "55%"; width "45%"; height "45%"; }
       pane { x "1%"; y "1%"; width "45%"; height "45%"; }
       pane { x "50%"; y "1%"; width "45%"; height "45%"; }
   }
}
